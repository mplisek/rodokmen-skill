root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 180

[*.xml]
max_line_length = off

[*.{json,yml,yaml,md,xml,xsd,html,css,js,ts,tsx}]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false
