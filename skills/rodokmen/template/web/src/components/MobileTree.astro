---
// Phone-friendly pedigree: parents, grandparents and great-grandparents of person k (or slug for a person from RODINA)
// as stacked two-column grids.
import { byK, people, lineByK, href, slot, rodiceSlotu, hloubka } from '../lib/data.js';
const { k, slug } = Astro.props;
let level = [slug ? slot(people[slug]) : { k, p: byK[k] ?? null }];
const radky = [2, 4, 8].map(() => (level = level.flatMap(rodiceSlotu)));
const levels = [
  ['Rodiče', 2],
  ['Prarodiče', 4],
  ['Praprarodiče', 8],
];
const genWord = (n) => (n < 5 ? 'generace' : 'generací');
---
<div class="mtree">
  {levels.map(([label, n], li) => (
    <section>
      <h3>{label}</h3>
      <div class="mtree-grid">
        {radky[li].map((sl) => {
          const p = sl.p;
          const line = p?.line ? lineByK[p.line] : null;
          const more = li === levels.length - 1 && p ? hloubka(sl) : 0;
          return p ? (
            <a class="mbox" href={href.person(p.slug)} style={line ? `border-left-color:${line.color}` : undefined}>
              <strong>{p.name}</strong><span>{p.years}</span>
              {more > 0 && <span class="more">a dál {more} {genWord(more)} →</span>}
            </a>
          ) : (
            <span class="mbox empty">?</span>
          );
        })}
      </div>
    </section>
  ))}
</div>
