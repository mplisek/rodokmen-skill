---
// Zápisy z matrik podle události: křest / narození, sňatek, úmrtí (a další prameny). Položka rejstříku je u své
// události označená „rejstřík“ – je to jen odkaz do knihy (jméno, datum, dům), samotný zápis jsme nečetli.
import Base from '../layouts/Base.astro';
import PersonLink from '../components/PersonLink.astro';
import { recordList, dateKey, href } from '../lib/data.js';
const list = [...recordList].sort((a, b) => dateKey(a.date) - dateKey(b.date));
const PORADI = ['N', 'O', 'Z', 'B', 'S', 'J'];
const skupiny = PORADI.map((k) => ({ k, rows: list.filter((r) => r.kind === k) })).filter((g) => g.rows.length);
const kotva = (k) => `druh-${k.toLowerCase()}`;
const rejstriku = list.filter((r) => r.index).length;
---
<Base title="Zápisy z matrik">
  <h1>Zápisy z matrik</h1>
  <p class="lead">Všech {list.length} zápisů, na kterých rodokmen stojí – podle události a v každé chronologicky. U každého je výřez snímku s vyznačeným místem, plné rozlišení a odkaz do archivu. Co v matrikách zatím chybí nebo si odporuje, najdete v přehledu <a href="/hledame/">co ještě hledáme</a>.</p>
  {rejstriku > 0 && <p class="small muted"><span class="kind kind-index">rejstřík</span> = jen položka abecedního rejstříku (jméno, datum, dům a odkaz do knihy). Samotný zápis s rodiči a kmotry jsme nečetli – kniha často není online.</p>}
  <p class="chips">{skupiny.map((g) => <a class="chip" href={`#${kotva(g.k)}`}>{g.rows[0].kindName} ({g.rows.length})</a>)}</p>
  {skupiny.map((g) => (
    <section id={kotva(g.k)}>
      <h2>{g.rows[0].kindName} <span class="small muted">({g.rows.length})</span></h2>
      <div class="table-box"><table>
        <thead><tr><th>Datum</th><th>Zápis</th><th>Týká se</th></tr></thead>
        <tbody>
          {g.rows.map((r) => (
            <tr>
              <td class="small" style="white-space:nowrap">{r.date}</td>
              <td><a href={href.record(r.key)}>{r.title}</a>{r.index && <> <span class="kind kind-index">rejstřík</span></>}<div class="small muted">{r.volume || r.vdesc}</div>
                {r.orig && (
                  <details class="transcript">
                    <summary>Text z matriky a překlad</summary>
                    <div class="tr-grid"><div><h4>Přepis originálu</h4><p class="tr-orig">{r.orig}</p></div><div><h4>Překlad</h4><p class="tr-cs">{r.cs}</p></div></div>
                  </details>
                )}
              </td>
              <td class="small">{r.people.map((s, i) => <>{i > 0 && ', '}<PersonLink slug={s} showYears={false} /></>)}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </section>
  ))}
</Base>
