---
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import Rod from '../../components/Rod.astro';
import Record from '../../components/Record.astro';
import { lines, people, hypotheses, href, genName, statusClass, lineByK } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.keys(lines).map((slug) => ({ params: { slug } }));
}
const l = lines[Astro.params.slug];
const members = l.people.map((s) => ({ ...people[s], gen: l.gens[s] }));
const gens = [...new Set(members.map((p) => p.gen))].sort((a, b) => a - b);
const root = people[l.root];
// rod začíná dědečkem (výchozí osoba 2. generace) → jeho manželka patří do rodů svých rodičů; jinak do sousedního rodu páru 8–15
const dedecek = root.gen === 2;
const partnerLine = dedecek ? null : lineByK[l.k ^ 1];
const wifeLines = dedecek && root.spouse
  ? [...new Set([people[root.spouse].father, people[root.spouse].mother].map((s) => people[s]?.lineSlug).filter(Boolean))].map((s) => lines[s]).filter(Boolean)
  : [];
---
<Base title={`Rod ${l.name}`}>
  <p class="crumbs"><a href="/rody/">Rody</a></p>
  <h1><Rod slug={l.slug} /></h1>
  <p class="lead">{l.desc}</p>
  <p>Rod začíná u <PersonLink slug={l.root} /> ({people[l.root].rel}).
    {partnerLine && people[l.root].spouse && (
      <>{people[l.root].sex === 'M' ? ' Jeho manželka ' : ' Její manžel '}<PersonLink slug={people[l.root].spouse} /> je výchozí osobou
        sousedního rodu <a href={href.line(partnerLine.slug)}>{partnerLine.name}</a>; jejich {people[people[l.root].child].sex === 'M' ? 'syn' : 'dcera'} <PersonLink slug={people[l.root].child} />.</>
    )}
    {wifeLines.length > 0 && <>{' '}Jeho manželka <PersonLink slug={root.spouse} /> pochází z {wifeLines.length === 1 ? 'rodu' : 'rodů'}
      {wifeLines.map((w, i) => <>{i ? ' a ' : ' '}<a href={href.line(w.slug)}>{w.name}</a></>)}.</>}
  </p>
  <p class="small muted">Rodokmen je rozdělený do osmi rodů. U dědečků začíná rod dědečkem (po mužské linii), u babiček až jejich rodiči (pradědečkem a prababičkou) – manželský pár proto patří do dvou sousedních rodů.</p>

  {gens.map((g) => (
    <>
      <h2>{genName(g)}</h2>
      <div class="table-box"><table>
        <thead><tr><th>Jméno</th><th>Život</th><th>Údaje</th><th>Stav</th></tr></thead>
        <tbody>
          {members.filter((p) => p.gen === g).map((p) => (
            <tr>
              <td><PersonLink slug={p.slug} showYears={false} /></td>
              <td class="small">{p.years}</td>
              <td class="small">{p.facts.slice(0, 2).join(' · ')}</td>
              <td><span class={`chip ${statusClass(p.st)}`}>{p.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </>
  ))}

  {hypotheses.filter((h) => h.line === l.k).map((h) => (
    <>
      <h2>{h.title}</h2>
      {h.text && <p class="prose">{h.text}</p>}
      {h.items.length > 0 && <ul class="facts">{h.items.map((o) => <li><strong>{o.name}</strong> – {o.text}</li>)}</ul>}
      <div class="recs">{h.records.map((r) => <Record id={r} />)}</div>
    </>
  ))}
</Base>
