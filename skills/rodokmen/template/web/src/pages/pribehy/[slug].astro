---
import Base from '../../layouts/Base.astro';
import Rod from '../../components/Rod.astro';
import { docs, stories } from '../../lib/data.js';

export async function getStaticPaths() {
  const storyModules = import.meta.glob('../../generated/pribehy/*.md');
  const paths = Object.entries(storyModules);
  return Promise.all(paths.map(async ([path, load]) => {
    const story = await load();
    const slug = path.split('/').pop().replace(/\.md$/, '');
    return {
      params: { slug },
      props: { Content: story.Content, frontmatter: story.frontmatter },
    };
  }));
}

const { Content, frontmatter } = Astro.props;
const slugPribehu = Astro.params.slug;
const story = stories.find((s) => s.slug === slugPribehu);
// dokumenty jen osob z rodu příběhu (rods z export_web.py); příběh bez rodu ukáže všechny
const rodyPribehu = (story?.rody ?? (frontmatter.rod ? [frontmatter.rod] : [])).map(Number).filter(Boolean);
const docsRodu = docs.filter((d) => !rodyPribehu.length || !d.rods?.length || d.rods.some((r) => rodyPribehu.includes(r)));
---
<Base title={frontmatter.title}>
  <p class="crumbs">
    <a href="/pribehy/">všechny příběhy</a>
    {rodyPribehu.map((k) => <> · <Rod k={k} /></>)}
  </p>
  <h1>{frontmatter.title}</h1>
  {frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}
  <div class="prose"><Content /></div>

  <div class="next-step">
    <p><strong>Chcete víc?</strong> Další objevy z rodokmenu najdete v zajímavostech.</p>
    <a class="btn" href="/zajimavosti/">Zajímavosti z rodokmenu →</a>
  </div>

  {docsRodu.length > 0 && (
    <>
      <h2>Rodinné dokumenty a fotografie</h2>
      <div class="docs">
        {docsRodu.map((d) => (
          <figure><a href={`/img/${d.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${d.img}.jpg`} alt={d.caption} loading="lazy" /></a><figcaption>{d.caption}</figcaption></figure>
        ))}
      </div>
    </>
  )}
</Base>
